{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZNote",
  "version": "0.5.8",
  "identifier": "app.znote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/build-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZNote",
        "visible": false,
        "width": 1440,
        "height": 920,
        "minWidth": 480,
        "minHeight": 620,
        "decorations": true,
        "dragDropEnabled": false,
        "backgroundColor": "#f8f8f6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' data:; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.iconify.design; frame-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/renderer-dist/znote-renderer/": "bin/znote-renderer/"
    },
    "shortDescription": "本地 Markdown 编辑与阅览",
    "category": "Productivity"
  }
}
